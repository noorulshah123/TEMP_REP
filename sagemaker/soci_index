FROM amazonlinux:2023

# Install dependencies
RUN dnf install -y \
        awscli \
        jq \
        git \
        ca-certificates \
        tar \
        gzip \
        which \
    && dnf clean all

# Install Finch
# Check the latest release at https://github.com/runfinch/finch/releases
ARG FINCH_VERSION="1.4.0"
RUN curl -L https://github.com/runfinch/finch/releases/download/v${FINCH_VERSION}/Finch-v${FINCH_VERSION}-Linux-x86_64.tar.gz \
        -o /tmp/finch.tar.gz \
    && tar -xzf /tmp/finch.tar.gz -C /usr/local \
    && rm /tmp/finch.tar.gz \
    && ln -sf /usr/local/bin/finch /usr/bin/finch \
    && finch --version

ENTRYPOINT ["/bin/bash"]


