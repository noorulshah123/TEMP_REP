        ${ECR_REGISTRY}/${REPOSITORY_NAME}:${SOCI_IMAGE_TAG}
    
    - echo "=== Verifying SOCI index in ECR ==="
    - |
      aws ecr describe-images \
        --repository-name ${REPOSITORY_NAME} \
        --image-ids imageTag=${SOCI_IMAGE_TAG} \
        --region ${AWS_REGION} \
        --output json
  needs:
