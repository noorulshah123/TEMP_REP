smoke-test-soci:
  stage: register
  image: amazon/aws-cli:latest
  <<: *aws-oidc-auth
  script:
    - echo "=== Verifying SOCI index manifest mediaType ==="
    - |
      MANIFEST=$(aws ecr batch-get-image \
        --repository-name ${REPOSITORY_NAME} \
        --image-ids imageTag=${SOCI_IMAGE_TAG} \
        --region ${AWS_REGION} \
        --query 'images[0].imageManifest' \
        --output text)
      
      echo "${MANIFEST}" | grep -q "vnd.oci.image.index" || \
        (echo "ERROR: SOCI tag does not contain expected index manifest" && exit 1)
      
      echo "${MANIFEST}" | jq '.manifests[] | {mediaType, platform}'
      echo "SOCI verification passed"
  needs:
    - create-soci-index
  rules:
    - if: $CI_COMMIT_BRANCH == "main"


