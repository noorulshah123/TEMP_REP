## .gitlab-ci.yml
variables:
  ACCOUNT_ID: "111122223333"           # Your AWS account
  REGION: "us-east-1"
  REPOSITORY_NAME: "your-sagemaker-image"
  ORIGINAL_IMAGE_TAG: "latest"
  SOCI_IMAGE_TAG: "latest-soci"        # Convention: -soci suffix

stages:
  - build         # Your existing image build job
  - soci-index    # NEW: SOCI index creation
  - deploy        # Your existing SageMaker registration

create-soci-index:
  stage: soci-index
  # Use a runner with root access and ability to install system packages
  tags:
    - abc-cloud-aws  # Adjust to your runner tag
  image: amazonlinux:2023
  before_script:
    - dnf install -y awscli jq containerd nerdctl soci-snapshotter
    - systemctl start soci-snapshotter
    - systemctl restart containerd
  script:
    # Variables already set globally; redeclare for clarity
    - REGISTRY="$ACCOUNT_ID.dkr.ecr.$REGION.amazonaws.com"
    - export AWS_REGION=$REGION
    
    # Authenticate to ECR
    - |
      REGISTRY_PASSWORD=$(aws ecr get-login-password --region $AWS_REGION)
      echo $REGISTRY_PASSWORD | nerdctl login -u AWS --password-stdin $REGISTRY
    
    # Pull the original image that the previous build stage pushed
    - nerdctl pull $REGISTRY/$REPOSITORY_NAME:$ORIGINAL_IMAGE_TAG
    
    # Create the SOCI index
    - |
      nerdctl image convert --soci \
        $REGISTRY/$REPOSITORY_NAME:$ORIGINAL_IMAGE_TAG \
        $REGISTRY/$REPOSITORY_NAME:$SOCI_IMAGE_TAG
    
    # Push the SOCI-indexed manifest back to ECR
    - nerdctl push --platform linux/amd64 $REGISTRY/$REPOSITORY_NAME:$SOCI_IMAGE_TAG
    
    # Verify the artifact was pushed
    - |
      aws ecr describe-images \
        --repository-name $REPOSITORY_NAME \
        --image-ids imageTag=$SOCI_IMAGE_TAG \
        --region $REGION
  rules:
    - if: $CI_COMMIT_BRANCH == "main"

variables:
  AWS_REGION: "us-east-1"
  AWS_ACCOUNT_ID: "111122223333"
  ECR_REGISTRY: "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
  REPOSITORY_NAME: "your-sagemaker-image"
  ORIGINAL_IMAGE_TAG: "${CI_COMMIT_SHORT_SHA}"
  SOCI_IMAGE_TAG: "${CI_COMMIT_SHORT_SHA}-soci"
  SAGEMAKER_IMAGE_NAME: "your-sagemaker-image"
  SAGEMAKER_ROLE_ARN: "arn:aws:iam::${AWS_ACCOUNT_ID}:role/SageMakerExecutionRole"
  # GitLab OIDC -> AWS role assumption
  AWS_ROLE_ARN_FOR_CI: "arn:aws:iam::${AWS_ACCOUNT_ID}:role/GitLabCIRole"

